{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "devhost-build-broker",
  "main": "worker.mjs",
  "compatibility_date": "2024-12-30",
  "r2_buckets": [
    {
      "binding": "DEVHOST_ARTIFACTS_BUCKET",
      "bucket_name": "devhost-artifacts"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "devhost-build-queue",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  }
}
