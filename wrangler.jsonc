{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "devhoist",
	"main": "worker-entry.mjs",
	"triggers": {
		"crons": [
			"0 0 * * *"
		]
	},
	"compatibility_date": "2024-12-30",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "devhoist"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"r2_buckets": [
		{
			"binding": "DEVHOST_ARTIFACTS_BUCKET",
			"bucket_name": "devhost-artifacts",
			"preview_bucket_name": "devhost-artifacts-preview"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "DEVHOST_BUILD_QUEUE",
				"queue": "devhost-build-queue"
			}
		]
	},
	"vars": {
		"NEXT_PUBLIC_SITE_URL": "https://devhostcloud.com",
		"NEXT_PUBLIC_SUPABASE_URL": "https://senlgfzhomodiyhnclfg.supabase.co",
		"NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_6gzAgaJBxEW53W7hfUhA4Q_v1A3ZX_I",
		"NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_6gzAgaJBxEW53W7hfUhA4Q_v1A3ZX_I"
	}
}
